# Copia este fichero a .env (nunca subas .env a git)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=obra
POSTGRES_USER=obra
POSTGRES_PASSWORD=obra
DATABASE_URL=postgres://obra:obra@db:5432/obra

# Puertos en tu equipo (otro proyecto local ya usa 8000, 5432, 5672 y 6379).
# La base de datos no se publica, así que no choca con otro PostgreSQL local en el 5432.
WEB_PORT=8001
MAIL_PORT=8025
